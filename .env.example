# Blockchain audit remains independently configurable; private operational data
# is synchronized through the encrypted relay rather than published on-chain.
VITE_ARGUS_BLOCKCHAIN_MODE=testnet

# The embedded wallet is always available in Settings. This setting selects
# testnet as the audit target; it never holds a key and mainnet is unavailable.

# Do not place wallet keys, mnemonics, seeds, signing secrets, or API credentials
# in VITE_* variables: Vite embeds them in the public browser bundle.
# Configure relay URL, organization ID, and enrollment secret in the in-app
# Settings panel on each device. Never put the enrollment secret in VITE_*.
